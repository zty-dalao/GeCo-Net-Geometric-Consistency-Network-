{
  "data_name": "thorax",
  "data_roots": {
    "thorax": [
      "E:\\workspace\\LightningRecon\\data\\thorax_fast",
      "~/autodl-tmp/thorax"
    ],
    "head": [
      "E:\\workspace\\LightningRecon\\data\\head_fast",
      "~/autodl-tmp/head"
    ]
  },
  "split": "train",
  "model": {
    "in_channels": 6,
    "out_channels": 1,
    "base_channels": 64,
    "num_down": 4,
    "num_regions": 4
  },
  "training": {
    "epochs": 300,
    "lr": 0.001,
    "rotors_per_case": 6,
    "use_cos_sin": true,
    "amp": true,
    "seed": 0,
    "zscore_max_cases": 16,
    "min_views": null,
    "clip_grad_norm": 1.0
  },
  "loss": {
    "ssim_window": 11,
    "val_range": 255.0,
    "alpha": 0.01,
    "lambda_consistency": 1.0,
    "vgg_feature_layers": 9,
    "vgg_weights": "IMAGENET1K_V1"
  },
  "logging": {
    "log_every_steps": 50,
    "checkpoint_every_epochs": 10
  }
}
